# Copy to .env locally. Never commit real credentials or paste them into chat.
DISCORD_TOKEN=
# PostgreSQL/Supabase connection string; use TLS. Keep it secret.
DATABASE_URL=
AUTO_MIGRATE=false
DATABASE_SSL=require
# Optional: faster command registration for one guild. Commands can take time to appear globally and may not be available in DMs.
TEST_GUILD_ID=1509560571563868160
# Public site the bot reads the payout/build API from (same value as ARCHANGLE_BASE_URL).
ARCHANGLE_BASE_URL=https://archangle.netlify.app
# Deprecated alias for the variable above; keep the same URL if you still set it.
PORTICO_BASE_URL=https://archangle.netlify.app
# Optional: set true (and enable Message Content Intent in the Developer Portal) to answer natural-language questions in channels without a mention or slash command. Replies are question-triggered and rate-limited; disable for privacy/no ambient chat.
MESSAGE_CONTENT_ENABLED=false
# Announcement ingestion is enabled by default; set false only to disable it. Requires Message Content Intent, channel history access, and the private-table migration.
ANNOUNCEMENT_INGESTION_ENABLED=true
# Curated announcement facts (what the bot answers ECR / promo / event questions from).
# After each announcement sync the bot re-dumps facts for every saved post, then calls the model configured
# below to type the posts it cannot read with patterns; that pass reuses AI_BASE_URL / AI_API_KEY / AI_MODEL.
# Set to false for a deterministic-only dump (no model calls, patterns and bold text only).
ANNOUNCEMENT_AI_EXTRACTION=true

# Optional comma-separated source channel IDs; unset uses the two reviewed defaults.
# 1512089401193271539 is explicitly excluded, even if listed here.
# ANNOUNCEMENT_CHANNEL_IDS=1524319795791659080,1570083896823906364
# The supplied Plarium Forum archive is searchable immediately; scheduled live refresh is on by default.
FORUM_SYNC_ENABLED=true
# Full scrape interval in seconds (1–48 hours; default 12 hours). Failed scrapes retry hourly.
FORUM_SYNC_SECONDS=43200
# Optional AI brain: current question, relevant verified game/archive facts, and at most five short-lived turns from this user and channel; never private notes or bystanders.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Development only: choose explicitly instead of DATABASE_URL; Railway's ephemeral filesystem is not durable.
ALLOW_LOCAL_STORAGE=false
LOCAL_STORAGE_PATH=./data/local_users.sqlite3

# Read-only data API and its public page, served by this same process. Off unless enabled: with no
# DATA_API_ENABLED and no PORT, nothing listens — a laptop run cannot open a port by accident.
DATA_API_ENABLED=false
# DATA_API_PORT falls back to Railway's PORT, then 8080. DATA_API_HOST defaults to 0.0.0.0.
# DATA_API_TOKEN=                     # optional bearer key; also locks the public page. Never commit one.
# DATA_API_ALLOW_ORIGIN=*             # or https://your-site.example to limit browser access
# DATA_API_MAX_LIMIT=200              # rows per page and per export, 10–20000
# DATA_API_CACHE_SECONDS=30           # ETag/304 fingerprint on every route except /health and /
# Standalone reader service only (python -m mechbot.api_server):
# MECH_BOT_SQLITE=./data/mech_bot_api_reader.sqlite3
