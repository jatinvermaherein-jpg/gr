# Copy to .env locally. Never commit real credentials or paste them into chat.
DISCORD_TOKEN=
# PostgreSQL/Supabase connection string; use TLS. Keep it secret.
DATABASE_URL=
AUTO_MIGRATE=false
DATABASE_SSL=require
# Optional: faster command registration for one guild. Commands can take time to appear globally and may not be available in DMs.
TEST_GUILD_ID=1509560571563868160
PORTICO_BASE_URL=https://portico-hq-live.netlify.app
# Optional AI brain: current question plus reviewed game facts only; no history or private notes.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Development only: choose explicitly instead of DATABASE_URL; Railway's ephemeral filesystem is not durable.
ALLOW_LOCAL_STORAGE=false
LOCAL_STORAGE_PATH=./data/local_users.sqlite3
