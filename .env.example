# Copy to .env locally. Never commit real credentials or paste them into chat.
DISCORD_TOKEN=
# PostgreSQL/Supabase connection string; use TLS. Keep it secret.
DATABASE_URL=
AUTO_MIGRATE=false
DATABASE_SSL=require
# Optional: faster command registration for one guild. Commands can take time to appear globally and may not be available in DMs.
TEST_GUILD_ID=1509560571563868160
PORTICO_BASE_URL=https://portico-hq-live.netlify.app
# Optional: set true (and enable Message Content Intent in the Developer Portal) to answer natural-language questions in channels without a mention or slash command. Replies are question-triggered and rate-limited; disable for privacy/no ambient chat.
MESSAGE_CONTENT_ENABLED=false
# Optional announcement ingestion; also requires Message Content Intent approval, channel access, and the private-table migration.
ANNOUNCEMENT_INGESTION_ENABLED=false
# Optional comma-separated source channel IDs; unset uses the three reviewed defaults.
# ANNOUNCEMENT_CHANNEL_IDS=1524319795791659080,1512089401193271539,1570083896823906364
# Optional AI brain: current question, relevant verified game/archive facts, and at most five short-lived turns from this user and channel; never private notes or bystanders.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Development only: choose explicitly instead of DATABASE_URL; Railway's ephemeral filesystem is not durable.
ALLOW_LOCAL_STORAGE=false
LOCAL_STORAGE_PATH=./data/local_users.sqlite3
